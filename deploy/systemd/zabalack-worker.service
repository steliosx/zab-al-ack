[Unit]
Description=Alerta Zabbix acknowledgement worker (reviewed configuration required)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/zabalack/config.json

[Service]
Type=simple
User=zabalack
Group=zabalack
WorkingDirectory=/var/lib/zabalack
ExecStart=/opt/zabalack/venv/bin/zabalack --config /etc/zabalack/config.json worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/zabalack
ReadWritePaths=/var/lib/zabalack
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zabalack

[Install]
WantedBy=multi-user.target
