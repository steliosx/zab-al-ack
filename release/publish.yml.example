# DISABLED TEMPLATE. Not under .github/workflows and never invoked by this build.
# After explicit publication authorization, complete RELEASING.md, pin/review
# this template, and install it as .github/workflows/publish.yml.
name: Publish reviewed beta candidate
on:
  workflow_dispatch:
    inputs:
      confirm_version:
        description: Exact reviewed beta candidate version
        required: true
        type: string
permissions:
  contents: read
env:
  TZ: UTC
jobs:
  build:
    if: github.ref == 'refs/tags/v0.1.0b1' && inputs.confirm_version == '0.1.0b1'
    uses: ./.github/workflows/ci.yml
    permissions:
      contents: read
  approve:
    needs: build
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: zabalack-candidate-${{ github.run_id }}-${{ github.run_attempt }}
          path: build/publish-input/
      # Verify source/package metadata and same-run evidence before staging.
      - run: python tools/verify_release.py --candidate build/publish-input
      - name: Use only the freshly verified reports for the publication gate
        run: |
          python - <<'PY'
          from pathlib import Path
          import shutil, sys
          sys.path.insert(0, 'tools')
          from collect_ci_evidence import clear_evidence
          clear_evidence(Path.cwd())
          shutil.copytree('build/publish-input/evidence', 'evidence', dirs_exist_ok=True)
          PY
          python tools/public_audit.py --publication
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: approved-python-distributions-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            build/attestation-subjects/*.whl
            build/attestation-subjects/*.tar.gz
          if-no-files-found: error
  publish:
    needs: approve
    runs-on: ubuntu-24.04
    environment: pypi
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: approved-python-distributions-${{ github.run_id }}-${{ github.run_attempt }}
          path: dist/
      - uses: pypa/gh-action-pypi-publish@76f52bc884231f62b9a034ebfe128415bbaabdfc # v1.12.4
        with:
          packages-dir: dist/
          attestations: true
