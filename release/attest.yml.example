# DISABLED TEMPLATE: review and deliberately install as .github/workflows/attest.yml.
# Issuance writes a repository attestation (and public Sigstore log for public
# repositories). It does not upload a Python package or create a GitHub release.
name: Attest reviewed alpha build
on:
  workflow_dispatch:
    inputs:
      reviewed_commit:
        description: Full reviewed commit SHA (must equal the selected alpha tag)
        required: true
        type: string
permissions:
  contents: read
env:
  TZ: UTC
jobs:
  build:
    if: >-
      vars.ZABALACK_ATTESTATIONS_ENABLED == 'true' &&
      github.event_name == 'workflow_dispatch' &&
      startsWith(github.ref, 'refs/tags/v') &&
      inputs.reviewed_commit == github.sha
    uses: ./.github/workflows/ci.yml
    permissions:
      contents: read
  attest:
    needs: build
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    environment: release-attestation
    permissions:
      contents: read
      id-token: write
      attestations: write
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
        with:
          persist-credentials: false
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: '3.12'
      # No token or cross-run selector. Reusable CI and signing share this run.
      - uses: actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131 # v7.0.0
        with:
          name: zabalack-candidate-${{ github.run_id }}-${{ github.run_attempt }}
          path: build/sign-input/
      - name: Validate reviewed tag and current-run subjects
        env:
          ZABALACK_REVIEWED_COMMIT: ${{ inputs.reviewed_commit }}
        run: |
          python - <<'PY'
          import os, tomllib
          from pathlib import Path
          version = tomllib.loads(Path('pyproject.toml').read_text())['project']['version']
          if os.environ['GITHUB_REF'] != 'refs/tags/v' + version or os.environ['ZABALACK_REVIEWED_COMMIT'] != os.environ['GITHUB_SHA']:
              raise SystemExit('Reviewed alpha tag/commit mismatch')
          PY
          python tools/verify_release.py --candidate build/sign-input
      - uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        id: provenance
        with:
          subject-path: build/attestation-subjects/*
          push-to-registry: false
          create-storage-record: false
      - uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6.0.0
        with:
          name: zabalack-attestation-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            ${{ steps.provenance.outputs.bundle-path }}
            build/attestation-subjects/
          if-no-files-found: error
          retention-days: 14
